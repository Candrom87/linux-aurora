  "full_kernel_cpu_regressions": {
    "old": {
      "scope": "CPU-only full-kernel regression using entirely invented boot metadata.\n\nRuns an ARM64 kernel under QEMU TCG, with synthetic EFI handoff tables and\nretained ADT bytes injected into guest RAM. There is no EFI firmware execution,\nMac hardware, GPU emulation/passthrough, host device, private input or root disk.\nThis exercises the kernel's real early-memory/paging/OF path, not GPU startup.\n",
      "all_boot_metadata_invented": true,
      "no_gpu_device_or_passthrough": true,
      "invented_fdt_restored_before_any_kernel_instruction": true,
      "synthetic_efi_recognized": true,
      "memory_preparation_accepted": false,
      "old_mapping_guard_bug_seen": true,
      "owned_guest_stopped_after_expected_early_bug": true,
      "guest_timed_out": false,
      "reaches_expected_no_root_disk_panic": false,
      "physical_gpu_or_mac_efi_stub_test": false
    },

+++ b/drivers/gpu/drm/apple/iomfb_v14_7.c
@@ -1463,11 +1463,16 @@ static void dcp_v14_crashed(void *cookie, const void *crashlog, size_t crashlog_
 	struct apple_dcp_v14 *v14 = cookie;
 	struct apple_dcp *dcp = READ_ONCE(v14->dcp);
 
-	WRITE_ONCE(v14->failed, true);
 	if (dcp) {
 		struct apple_connector *connector = READ_ONCE(dcp->connector);
 
-		WRITE_ONCE(dcp->crashed, true);
+		/* Serialize the crash with a modeset accepting its reply. */
+		scoped_guard(spinlock_irqsave, &dcp->mode_state.lock) {
+			WRITE_ONCE(v14->failed, true);
+			WRITE_ONCE(dcp->crashed, true);
+			dcp->mode_state.valid = false;
+			dcp->mode_state.invalidated = true;
+		}
 		if (dcp->external)
 			dcpext_scanout_fault(dcp, -EIO);
 		/* The display it drove is gone until reboot. */
@@ -1476,7 +1481,8 @@ static void dcp_v14_crashed(void *cookie, const void *crashlog, size_t crashlog_
 			apple_connector_edid_set_live(connector, false);
 			dcp_queue_hotplug(connector);
 		}
-	}
+	} else
+		WRITE_ONCE(v14->failed, true);
 	dev_err(v14->dev, "DCP firmware crashed; its buffers are kept until reboot\n");
 	dcp_v14_link_fail(&v14->link);
 }
@@ -3217,6 +3223,22 @@ static void dcp_v14_audio_on(struct apple_dcp *dcp)
 	av_service_connect(dcp);
 }
 
+/* A crash can arrive after the last RPC and before the mode is accepted. */
+static int dcp_v14_accept_mode(struct apple_dcp *dcp, struct apple_dcp_v14 *v14)
+{
+	int ret = 0;
+
+	scoped_guard(spinlock_irqsave, &dcp->mode_state.lock) {
+		if (READ_ONCE(dcp->crashed) || (v14 && READ_ONCE(v14->failed)))
+			ret = -EIO;
+		else if (dcp->mode_state.changing && dcp->mode_state.invalidated)
+			ret = -EAGAIN;
+		else
+			dcp->mode_state.valid = true;
+	}
+	return ret;
+}
+

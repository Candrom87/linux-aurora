diff --git a/tools/asahi/dcp-v14-crash-state.py b/tools/asahi/dcp-v14-crash-state.py
new file mode 100644
index 000000000..14c314c07
--- /dev/null
+++ b/tools/asahi/dcp-v14-crash-state.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""Exercise the V14 crash and mode-accept functions with fake devices."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+source = (root / 'drivers/gpu/drm/apple/iomfb_v14_7.c').read_text()
+
+
+def extract(signature):
+    start = source.index(signature)
+    brace = source.index('{', start)
+    depth = 0
+    for pos in range(brace, len(source)):
+        if source[pos] == '{':
+            depth += 1
+        elif source[pos] == '}':
+            depth -= 1
+            if depth == 0:
+                return source[start:pos + 1]
+    raise ValueError('unterminated function ' + signature)
+
+
+code = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+
+struct dcp_mode_state { pthread_mutex_t lock; bool valid, invalidated, changing; };
+struct apple_connector { bool connected; };
+struct apple_dcp { struct dcp_mode_state mode_state; struct apple_connector *connector;
+                   bool crashed, external, external_detached; };
+struct dcp_v14_link { bool failed; };
+struct apple_dcp_v14 { struct apple_dcp *dcp; struct dcp_v14_link link;
+                       bool failed, external; void *dev; };
+static int faults, hotplugs, edid_stops;
+#define READ_ONCE(x) (x)
+#define WRITE_ONCE(x, y) ((x) = (y))
+#define scoped_guard(kind, lock_ptr) \
+    for (int once = (pthread_mutex_lock(lock_ptr), 1); once; \
+         once = 0, pthread_mutex_unlock(lock_ptr))
+#define dev_err(...) ((void)0)
+static void dcpext_scanout_fault(struct apple_dcp *d, int err)
+{ assert(d && err == -EIO); faults++; }
+static void apple_connector_edid_set_live(struct apple_connector *c, bool live)
+{ assert(c && !live); edid_stops++; }
+static void dcp_queue_hotplug(struct apple_connector *c) { assert(c); hotplugs++; }
+static void dcp_v14_link_fail(struct dcp_v14_link *l) { l->failed = true; }
+CRASH
+ACCEPT
+
+struct race { struct apple_dcp *dcp; struct apple_dcp_v14 *v14; int ret; };
+static void *accept_thread(void *p) {
+    struct race *r = p; r->ret = dcp_v14_accept_mode(r->dcp, r->v14); return NULL;
+}
+static void *crash_thread(void *p) {
+    struct race *r = p; dcp_v14_crashed(r->v14, NULL, 0); return NULL;
+}
+int main(void) {
+    struct apple_dcp d = {.mode_state.lock = PTHREAD_MUTEX_INITIALIZER};
+    struct apple_dcp_v14 v = {.dcp = &d};
+    assert(dcp_v14_accept_mode(&d, &v) == 0 && d.mode_state.valid);
+    d.mode_state.changing = true;
+    dcp_v14_crashed(&v, NULL, 0);
+    assert(v.failed && v.link.failed && d.crashed);
+    assert(!d.mode_state.valid && d.mode_state.invalidated);
+    assert(dcp_v14_accept_mode(&d, &v) == -EIO && !d.mode_state.valid);
+    d.mode_state.invalidated = false; /* begin cannot revive a crashed session */
+    assert(dcp_v14_accept_mode(&d, &v) == -EIO && !d.mode_state.valid);
+
+    d.crashed = false; v.failed = false; d.mode_state.invalidated = true;
+    assert(dcp_v14_accept_mode(&d, &v) == -EAGAIN && !d.mode_state.valid);
+    d.mode_state.changing = false; /* preserve idle acceptance semantics */
+    assert(dcp_v14_accept_mode(&d, &v) == 0 && d.mode_state.valid);
+    struct apple_dcp_v14 detached = {0};
+    dcp_v14_crashed(&detached, NULL, 0);
+    assert(detached.failed && detached.link.failed);
+
+    struct apple_connector con = {.connected = true};
+    d.connector = &con; d.external = true; v.external = true;
+    dcp_v14_crashed(&v, NULL, 0);
+    assert(!con.connected && faults == 1 && hotplugs == 1 && edid_stops == 1);
+
+    /* Either lock order is allowed; after both finish the mode is invalid. */
+    d.connector = NULL; d.external = false; v.external = false;
+    for (int i = 0; i < 250; ++i) {
+        d.crashed = false; v.failed = false; d.mode_state.valid = false;
+        d.mode_state.invalidated = false; d.mode_state.changing = true;
+        struct race r = {&d, &v, 0}; pthread_t a, b;
+        assert(!pthread_create(&a, NULL, accept_thread, &r));
+        assert(!pthread_create(&b, NULL, crash_thread, &r));
+        assert(!pthread_join(a, NULL)); assert(!pthread_join(b, NULL));
+        assert((r.ret == 0 || r.ret == -EIO) && !d.mode_state.valid);
+        assert(d.mode_state.invalidated && d.crashed && v.failed);
+    }
+    puts("V14 crash state and 250 concurrent mode-accept races passed (fake devices)");
+}
+'''.replace('CRASH', extract('static void dcp_v14_crashed(')).replace(
+    'ACCEPT', extract('static int dcp_v14_accept_mode('))
+
+with tempfile.TemporaryDirectory(prefix='dcp-v14-crash-') as tmp:
+    cfile = Path(tmp) / 'test.c'
+    binary = Path(tmp) / 'test'
+    cfile.write_text(code)
+    subprocess.run(['cc', '-std=c11', '-Wall', '-Wextra', '-Wno-unused-parameter',
+                    '-Werror', '-pthread', str(cfile), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)

+/*
+ * T6034 has not been tested on hardware. Guard each access separately, so a
+ * failed read cannot become the value of a subsequent read-modify-write.
+ * Like pmgr_set_mode(), this clears auto and sticky gate bits and polls for
+ * the requested actual state. An abort guard cannot protect against a bus
+ * transaction that never completes, nor make an unknown transition safe.
+ */
+static int t6034_ps_read(u64 addr, u32 *val)
+{
+    int g = guard_begin();
+    u32 v = read32(addr);
+    if (guard_end(g))
+        return -1;
+    *val = v;
+    return 0;
+}
+
+static int t6034_ps_write(u64 addr, u32 val)
+{
+    int g = guard_begin();
+    write32(addr, val);
+    return guard_end(g);
+}
+
+static int t6034_ps_mode(u64 addr, u32 mode)
+{
+    u32 v;
+    if (t6034_ps_read(addr, &v))
+        return -1;
+    if (!(v & PS_AUTO_ENABLE) && FIELD_GET(PS_TARGET, v) == mode &&
+        FIELD_GET(PS_ACTUAL, v) == mode)
+        return 0;
+    v = (v & ~(PS_AUTO_ENABLE | PS_WAS_CLKGATED | PS_WAS_PWRGATED | PS_TARGET)) |
+        FIELD_PREP(PS_TARGET, mode);
+    if (t6034_ps_write(addr, v))
+        return -1;
+    for (int i = 0; i < 10000; i++) {
+        if (t6034_ps_read(addr, &v))
+            return -1;
+        if (FIELD_GET(PS_ACTUAL, v) == mode)
+            return 0;
+        udelay(1);
+    }
+    return -1;
+}

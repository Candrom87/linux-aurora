+/* The J514M ADT's power graph, exercised only against mock PMGR registers. */
+static void sc_j514m_gpu_power_case(void *dt, bool timeout)
+{
+    struct t6031_closure closure;
+    (void)dt;
+    world(&(struct opts){0});
+    chip_id = T6034;
+    assert(pmgr_init() == 0);
+    memcpy(snap, regs, sizeof(regs));
+    nsnap = nregs;
+    int ret = t6031_closure_get("/arm-io/sgx", &closure);
+    check(ret == 0, "J514M GPU: power closure resolves");
+    if (ret)
+        return;
+    check(closure.n == 2 && closure.ps[0].addr == PS_GFX && closure.ps[1].addr == PS_AFR,
+          "J514M GPU: closure contains GFX and AFR, in child-first order");
+    if (timeout)
+        stuck_off = PS_GFX;
+    ret = pmgr_adt_power_enable("/arm-io/sgx");
+    if (timeout)
+        check(ret != 0, "J514M GPU: simulated power-on timeout is reported");
+    else
+        check(ret == 0 && t6031_closure_active(&closure) == 0,
+              "J514M GPU: mock closure powers on");
+    ret = t6031_closure_restore(&closure);
+    check(ret == 0 && !changed_registers(snap, nsnap, 0),
+          "J514M GPU: mock closure is restored");
+    check(!gpu_reads && !unguarded, "J514M GPU: no GPU identity access or unguarded fault");
+}
+
+static void sc_j514m_gpu_power(void *dt) { sc_j514m_gpu_power_case(dt, false); }
+static void sc_j514m_gpu_timeout(void *dt) { sc_j514m_gpu_power_case(dt, true); }

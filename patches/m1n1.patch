+static void sc_j514m_image_only(void *dt, enum image_only_case scenario)
+{
+    static const char good[] = "apple,j514m\0apple,t6034\0apple,arm-platform";
+    static const char bad[] = "apple,j516m\0apple,t6034\0apple,arm-platform";
+    const char *compatible = scenario == IMAGE_WRONG_BOARD ? bad : good;
+    size_t size = scenario == IMAGE_WRONG_BOARD ? sizeof(bad) : sizeof(good);
+    const char *image = "/chosen/asahi,t6034-gpu-image";
+    int n, len;
+
+    world(&(struct opts){0});
+    chip_id = T6034;
+    assert(!fdt_setprop(dt, 0, "compatible", compatible, size));
+    assert(!fdt_setprop_string(dt, fdt_path_offset(dt, "gpu"), "compatible",
+                               scenario == IMAGE_WRONG_NODE ? "apple,agx-t6031" : "apple,agx-t6034"));
+    assert(!fdt_setprop_string(dt, fdt_path_offset(dt, "gpu"), "status",
+                               scenario == IMAGE_ENABLED_GPU ? "okay" : "disabled"));
+    if (scenario != IMAGE_UNARMED)
+        chosen_set(dt, "asahi,t6034-gpu-image-probe", scenario == IMAGE_DISABLED_OPTION ? "0" : "1");
+    if (scenario == IMAGE_WRONG_ADT) {
+        u32 compat_len;
+        int sgx = adt_path_offset(adt, "/arm-io/sgx");
+        char *compat = (char *)adt_getprop(adt, sgx, "compatible", &compat_len);
+        assert(compat && compat_len == sizeof("gpu,t6034"));
+        compat[0] = 'x';
+    }
+    if (scenario == IMAGE_DUPLICATE)
+        assert(fdt_add_subnode(dt, fdt_path_offset(dt, "/chosen"),
+                               "asahi,t6034-gpu-image") >= 0);
+    const struct adt_segment_ranges *segments = adt_segs("/arm-io/gfx-asc", &n);
+    assert(n == 2);
+    if (scenario == IMAGE_NO_MCC_INVENTORY)
+        mcc_carveouts_valid = false;
+    if (scenario == IMAGE_PROTECTED_HEADER) {
+        mcc_carveout_count = 1;
+        mcc_carveouts[0] = (struct mcc_carveout){segments[0].phys + 0x4000, 0x4000};
+    }
+    if (scenario == IMAGE_BAD_HEADER) {
+        u32 zero = 0;
+        memcpy(dram_at(segments[0].phys + 0x4200, sizeof(zero)), &zero, sizeof(zero));
+    }
+    if (scenario == IMAGE_READ_FAULT)
+        inject_dram_fault = segments[0].phys + 0x4200;
+    if (scenario == IMAGE_RTKIT_FAULT)
+        inject_dram_fault = segments[0].phys + 0x5c100;
+    nwrites = gpu_reads = ps_reads = dram_reads = 0;
+    assert(dt_set_gpu(dt) == 0);
+    check(!nwrites && !gpu_reads && !ps_reads, "image-only: no PMGR or GPU access");
+    check(!unguarded, "image-only: no unguarded fault");
+    check(!strcmp(status_of(dt, "gpu"), scenario == IMAGE_ENABLED_GPU ? "okay" : "disabled"),
+          "image-only: GPU status unchanged");
+    if (scenario == IMAGE_OK || scenario == IMAGE_RTKIT_FAULT) {
+        const void *uuid = prop(dt, image, "image-uuid", &len);
+        check(uuid && len == 16 && !memcmp(uuid, sim_image_uuid, 16),
+              "image-only: simulated firmware identity published");
+        check(dram_reads > 0, "image-only: simulated firmware memory was read");
+        if (scenario == IMAGE_RTKIT_FAULT) {
+            check(u32_is(dt, image, "rtkit-version-present", 0),
+                  "image-only: faulted RTKit version is absent");
+            check(dram_reads == 2 * GFX_FW_HDR_SIZE / 4,
+                  "image-only: no byte reads after the first RTKit fault");
+            check(exc_count > 0, "image-only: RTKit read fault was guarded");
+        }
+    } else {
+        check(!prop(dt, image, "image-uuid", NULL), "image-only: no identity on refusal");
+        if (scenario == IMAGE_UNARMED || scenario == IMAGE_WRONG_BOARD ||
+            scenario == IMAGE_WRONG_NODE || scenario == IMAGE_DUPLICATE ||
+            scenario == IMAGE_DISABLED_OPTION || scenario == IMAGE_ENABLED_GPU ||
+            scenario == IMAGE_WRONG_ADT || scenario == IMAGE_NO_MCC_INVENTORY ||
+            scenario == IMAGE_PROTECTED_HEADER)
+            check(!dram_reads, "image-only: refusal precedes firmware memory read");
+        if (scenario == IMAGE_READ_FAULT) {
+            check(exc_count > 0, "image-only: firmware read fault was guarded");
+            check(!dram_reads, "image-only: no later header read after the first fault");
+        }
+    }
+}

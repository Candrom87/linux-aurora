+# Host-only static preflight: this wrapper is appended to the temporary copy,
+# never to the m1n1 image. It inspects ADT/DT inputs, without firmware admission,
+# power votes, GPU reads, FDT changes or a T6034 enablement path.
+cat >> "$tmp/src/kboot_gpu.c" <<'EOF'
+int host_j514m_gpu_tables(void *dt)
+{
+    int gpu = fdt_path_offset(dt, "gpu"), sgx = adt_path_offset(adt, "/arm-io/sgx");
+    u32 count, tables, sram;
+    const struct perf_state *ps;
+    struct g15_power_values pv;
+    struct g15_aux aux[2] = {{.adt = "cs-perf-states", .dt = "apple,cs-opp"},
+                             {.adt = "afr-perf-states", .dt = "apple,afr-opp"}};
+    if (gpu < 0 || sgx < 0)
+        return 1;
+    if (g15_get_pstates(&g15_soc_t6031, sgx, &count, &tables, &ps))
+        return 2;
+    if (g15_get_power_props(sgx, count, tables, ps, &pv))
+        return 3;
+    if (g15_get_aux(dt, gpu, sgx, 1, &aux[0]) || g15_get_aux(dt, gpu, sgx, 1, &aux[1]))
+        return 4;
+    if (g15_csafr_sram(aux, pv.min_sram_uv, &sram))
+        return 5;
+    return 0;
+}

+#!/bin/sh
+# Run the real mcc_unmap_carveouts body with a simulated MCC/ADT.
+set -eu
+cd "$(dirname "$0")/.."
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT HUP INT TERM
+awk '/^int mcc_unmap_carveouts\(void\)/ {on=1} on {print} on && /^}/ {exit}' \
+    src/mcc.c > "$tmp/mcc_unmap_extracted.inc"
+grep -q 'mcc_carveouts_valid = !invalid' "$tmp/mcc_unmap_extracted.inc"
+${CC:-cc} -std=c11 -O2 -Wall -Wextra -Werror -I "$tmp" \
+    tests/mcc_carveout_host.c -o "$tmp/test"
+"$tmp/test"

+static void sc_thirty_core_layout(void *dt)
+{
+    /* Synthetic 8/8/7/7 mask, independent of any Mac's actual fuse bits. */
+    u64 mask = 0xffULL | (0xffULL << 10) | (0x7fULL << 20) | (0x7fULL << 30);
+    struct t8122_powered_identity id = {
+        .id_version = 0x07041100, .id_counts_1 = 0x0021040a,
+        .core_mask = {(u32)mask, (u32)(mask >> 32), 0},
+    };
+    u32 counts[T6031_GPU_CLUSTERS] = {0};
+    UNUSED(dt);
+    check(t6031_identity_valid(&id), "30-core G15C identity accepted");
+    u32 total = t6031_core_counts(&id, counts);
+    check(total == 30 && counts[0] == 8 && counts[1] == 8 && counts[2] == 7 && counts[3] == 7,
+          "30-core mask decoded into four clusters (8/8/7/7)");
+}

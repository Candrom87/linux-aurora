+enum j514m_probe_case { PROBE_OK, PROBE_UNARMED, PROBE_WRONG_BOARD, PROBE_TIMEOUT, PROBE_FAULT,
+                        PROBE_RESTORE_FAIL, PROBE_WRONG_NODE, PROBE_DUPLICATE,
+                        PROBE_PS_READ_FAULT, PROBE_PS_WRITE_FAULT, PROBE_PS_POLL_FAULT,
+                        PROBE_KEEP_PARENT_ON, PROBE_BAD_IMAGE };
+
+static void sc_j514m_probe(void *dt, enum j514m_probe_case scenario)
+{
+    static const char good[] = "apple,j514m\0apple,t6034\0apple,arm-platform";
+    static const char bad[] = "apple,j516m\0apple,t6034\0apple,arm-platform";
+    const char *compatible = scenario == PROBE_WRONG_BOARD ? bad : good;
+    size_t size = scenario == PROBE_WRONG_BOARD ? sizeof(bad) : sizeof(good);
+    world(&(struct opts){ .gpu_fault = scenario == PROBE_FAULT });
+    chip_id = T6034;
+    if (scenario == PROBE_BAD_IMAGE) {
+        int n;
+        const struct adt_segment_ranges *segments = adt_segs("/arm-io/gfx-asc", &n);
+        u32 zero = 0;
+        memcpy(dram_at(segments[0].phys + 0x4200, sizeof(zero)), &zero, sizeof(zero));
+    }
+    if (scenario == PROBE_OK)
+        reg_set(SGX + 0xd04000, 0x01020304, R_GPU); /* deliberately not a T6031 identity */
+    assert(!fdt_setprop(dt, 0, "compatible", compatible, size));
+    assert(!fdt_setprop_string(dt, fdt_path_offset(dt, "gpu"), "compatible",
+                               scenario == PROBE_WRONG_NODE ? "apple,agx-t6031" : "apple,agx-t6034"));
+    assert(!fdt_setprop_string(dt, fdt_path_offset(dt, "gpu"), "status", "disabled"));
+    if (scenario != PROBE_UNARMED)
+        chosen_set(dt, "asahi,t6034-gpu-probe", "1");
+    if (scenario == PROBE_DUPLICATE)
+        assert(fdt_add_subnode(dt, fdt_path_offset(dt, "/chosen"),
+                               "asahi,t6034-gpu-powered-identity") >= 0);
+    assert(pmgr_init() == 0);
+    if (scenario == PROBE_KEEP_PARENT_ON)
+        reg_set(PS_AFR, 0, R_PS); /* simulated initially off parent */
+    memcpy(snap, regs, sizeof(regs));
+    nsnap = nregs;
+    nwrites = 0;
+    if (scenario == PROBE_TIMEOUT)
+        stuck_off = PS_GFX;
+    if (scenario == PROBE_RESTORE_FAIL || scenario == PROBE_KEEP_PARENT_ON)
+        stuck_on = PS_GFX;
+    inject_ps_write_fault = scenario == PROBE_PS_WRITE_FAULT;
+    inject_ps_poll_fault = scenario == PROBE_PS_POLL_FAULT;
+    if (scenario == PROBE_PS_READ_FAULT)
+        inject_ps_read_number = 2; /* snapshot succeeds, read before GFX write faults */
+    assert(dt_set_gpu(dt) == 0);
+    const char *node = "/chosen/asahi,t6034-gpu-powered-identity";
+    if (scenario == PROBE_UNARMED || scenario == PROBE_WRONG_BOARD ||
+        scenario == PROBE_WRONG_NODE || scenario == PROBE_DUPLICATE) {
+        check((scenario == PROBE_DUPLICATE || node_at(dt, node) < 0) && !gpu_reads && !nwrites,
+              "J514M probe refused: no GPU read and no register writes");
+    } else {
+        u32 expected = (scenario == PROBE_OK || scenario == PROBE_BAD_IMAGE) ? T8122_ID_PASS :
+                       (scenario == PROBE_TIMEOUT || scenario == PROBE_PS_READ_FAULT ||
+                        scenario == PROBE_PS_WRITE_FAULT ||
+                        scenario == PROBE_PS_POLL_FAULT) ? T8122_ID_POWER_FAILED :
+                       scenario == PROBE_FAULT ? T8122_ID_READ_FAULT : T8122_ID_POWER_OFF_FAILED;
+        check(u32_is(dt, node, "probe-result", expected), "J514M probe publishes result %u", expected);
+        if (scenario == PROBE_OK)
+            check(u32_is(dt, node, "id-version", 0x01020304),
+                  "J514M probe publishes raw ID without T6031 validation");
+        if (scenario == PROBE_TIMEOUT || scenario == PROBE_PS_READ_FAULT ||
+            scenario == PROBE_PS_WRITE_FAULT ||
+            scenario == PROBE_PS_POLL_FAULT)
+            check(!gpu_reads, "J514M probe does not read GPU after power-on failure");
+        if (scenario == PROBE_PS_READ_FAULT) {
+            bool wrote_gfx = false;
+            for (int i = 0; i < nwrites; i++)
+                wrote_gfx |= writes[i].addr == PS_GFX;
+            check(!inject_ps_read_number && !wrote_gfx,
+                  "J514M probe never writes GFX after its mode read faults");
+        }
+        if (scenario != PROBE_RESTORE_FAIL && scenario != PROBE_KEEP_PARENT_ON)
+            check(!changed_registers(snap, nsnap, 0), "J514M probe restores simulated power state");
+        if (scenario == PROBE_KEEP_PARENT_ON)
+            check(FIELD_GET(GENMASK(7, 4), reg_val(PS_AFR)) == 0xf &&
+                  FIELD_GET(GENMASK(3, 0), reg_val(PS_AFR)) == 0xf,
+                  "J514M probe keeps parent active after child restore failure");
+    }
+    const char *image = "/chosen/asahi,t6034-gpu-image";
+    if (scenario == PROBE_OK) {
+        int len;
+        const void *uuid = prop(dt, image, "image-uuid", &len);
+        const char *rtkit = prop(dt, image, "image-rtkit-version", NULL);
+        check(uuid && len == 16 && !memcmp(uuid, sim_image_uuid, 16) && rtkit &&
+              !strcmp(rtkit, sim_rtkit), "J514M publishes simulated firmware identity");
+    } else if (scenario == PROBE_BAD_IMAGE) {
+        check(node_at(dt, image) < 0, "J514M refuses a malformed firmware header");
+    }
+    check(!strcmp(status_of(dt, "gpu"), "disabled"), "J514M probe leaves GPU disabled");
+    check(!unguarded && !gpu_reads_unpowered, "J514M probe has no unguarded or unpowered reads");
+}

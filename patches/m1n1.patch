+    for (int i = 0; i < c->n; i++) {
+        struct t6031_ps *p = &c->ps[i];
+        u32 now, want = FIELD_GET(PS_TARGET, p->before);
+        if (t6034_ps_read(p->addr, &now)) {
+            ret = -1;
+            break;
+        }
+        if ((FIELD_GET(PS_TARGET, now) != want ||
+             (!(p->before & PS_AUTO_ENABLE) && (now & PS_AUTO_ENABLE))) &&
+            t6034_ps_mode(p->addr, want)) {
+            ret = -1;
+            break;
+        }
+        if (p->before & PS_AUTO_ENABLE) {
+            if (t6034_ps_read(p->addr, &now) ||
+                t6034_ps_write(p->addr, (now & ~(PS_WAS_CLKGATED | PS_WAS_PWRGATED)) |
+                                          PS_AUTO_ENABLE)) {
+                ret = -1;
+                break;
+            }
+        }
+        /* Never restore a parent until this child is confirmed restored. */
+        if (t6034_ps_read(p->addr, &now) || !closure_same(p->before, now)) {
+            ret = -1;
+            break;
+        }
+    }
+    for (int i = 0; i < c->n; i++) {
+        if (t6034_ps_read(c->ps[i].addr, &c->ps[i].after) ||
+            !closure_same(c->ps[i].before, c->ps[i].after))
+            ret = -1;
+    }
+    return ret;

+/* Static inputs only; applying the T6031 parser is not T6034 admission. */
+enum gpu_tables_case { GPU_TABLES_OBSERVED, GPU_TABLES_BAD_COUNT, GPU_TABLES_BAD_SRAM };
+
+static void sc_j514m_gpu_tables_case(void *dt, enum gpu_tables_case which)
+{
+    world(&(struct opts){0});
+    chip_id = T6034;
+    if (which != GPU_TABLES_OBSERVED) {
+        int sgx = adt_path_offset(adt, "/arm-io/sgx");
+        u32 len, value = which == GPU_TABLES_BAD_COUNT ? 99 : 0;
+        const char *name = which == GPU_TABLES_BAD_COUNT ? "gpu-num-perf-states" :
+                                                            "perf-states-sram";
+        u8 *p = (u8 *)adt_getprop(adt, sgx, name, &len);
+        size_t offset = which == GPU_TABLES_BAD_COUNT ? 0 : 12; /* state 1 voltage */
+        assert(p && len >= offset + sizeof(value));
+        memcpy(p + offset, &value, sizeof(value));
+    }
+    size_t size = fdt_totalsize(dt);
+    void *before = malloc(size);
+    assert(before);
+    memcpy(before, dt, size);
+    nwrites = 0;
+    int ret = host_j514m_gpu_tables(dt);
+    int expected = which == GPU_TABLES_OBSERVED ? 0 : which == GPU_TABLES_BAD_COUNT ? 2 : 3;
+    check(ret == expected, "J514M static GPU table preflight: result %d expected %d", ret,
+          expected);
+    check(!nwrites && !gpu_reads, "J514M static GPU table preflight: no mock hardware access");
+    check(!memcmp(before, dt, size), "J514M static GPU table preflight: DT unchanged");
+    free(before);
+}
+static void sc_j514m_gpu_tables(void *dt) { sc_j514m_gpu_tables_case(dt, GPU_TABLES_OBSERVED); }
+static void sc_j514m_gpu_bad_count(void *dt) { sc_j514m_gpu_tables_case(dt, GPU_TABLES_BAD_COUNT); }
+static void sc_j514m_gpu_bad_sram(void *dt) { sc_j514m_gpu_tables_case(dt, GPU_TABLES_BAD_SRAM); }

+/* The J514M path uses real ADT layout data and simulated registers/page tables. */
+enum j514m_case { J514M_PUBLISH, J514M_POWER_OFF, J514M_WRONG_IMAGE, J514M_WRONG_OS,
+                  J514M_POWER_FAULT, J514M_MISSING_FE, J514M_MISSING_CPU };
+
+static void sc_j514m(void *dt, enum j514m_case scenario)
+{
+    static const char compat[] = "apple,j514m\0apple,t6034\0apple,arm-platform";
+    bool power_off = scenario == J514M_POWER_OFF;
+    world(&(struct opts){ .display_off = power_off });
+    chip_id = T6034;
+    /* Synthetic usable-RAM interval and framebuffer inside the synthetic vram
+     * segment. These are simulation inputs, not measurements of this Mac. */
+    ram_min = 0x10010000000UL;
+    ram_len = 0x10000000UL;
+    int seg_count;
+    const struct adt_segment_ranges *display_seg = adt_segs("/arm-io/dcp/iop-dcp-nub", &seg_count);
+    assert(seg_count > 6);
+    fb_base = display_seg[6].phys + 0x4000;
+    assert(!fdt_setprop(dt, 0, "compatible", compat, sizeof(compat)));
+    assert(!fdt_setprop_string(dt, fdt_path_offset(dt, "dcp"), "compatible", "apple,t6034-dcp"));
+    assert(!fdt_setprop_string(dt, fdt_path_offset(dt, "disp0"), "compatible",
+                               "apple,t6034-display-subsystem"));
+    chosen_set(dt, "asahi,t6034-dcp", "1");
+    if (scenario == J514M_WRONG_IMAGE) {
+        u32 len;
+        int nub = adt_path_offset(adt, "/arm-io/dcp/iop-dcp-nub");
+        char *uuid = (char *)adt_getprop(adt, nub, "uuid", &len);
+        assert(uuid && len == 37);
+        uuid[0] = '0';
+    }
+    if (scenario == J514M_WRONG_OS)
+        os_firmware.version = V14_8_3;
+    if (scenario == J514M_MISSING_FE || scenario == J514M_MISSING_CPU) {
+        u32 len;
+        int dcp_node = adt_path_offset(adt, "/arm-io/dcp");
+        u32 *gates = (u32 *)adt_getprop(adt, dcp_node, "clock-gates", &len);
+        assert(gates && len == sizeof(*gates));
+        /* Replace the virtual gate by just one of its two real parents. */
+        *gates = scenario == J514M_MISSING_FE ? 280 : 279;
+    }
+    assert(pmgr_init() == 0);
+    if (power_off)
+        reg_set(PS_DISP_CPU, 0, R_PS);
+    if (scenario == J514M_POWER_FAULT) {
+        ps_reads = 0;
+        inject_display_first_ps_fault = true;
+    }
+    if (scenario == J514M_MISSING_FE || scenario == J514M_MISSING_CPU)
+        ps_reads = 0;
+    nwrites = 0;
+    assert(dt_set_display_handoff(dt) == 0);
+    int dcp = fdt_path_offset(dt, "dcp"), disp = fdt_path_offset(dt, "disp0");
+    int pio = fdt_path_offset(dt, "disp0-piodma");
+    bool marked = u32_is(dt, "dcp", "apple,t6034-handoff", 1) &&
+                  u32_is(dt, "disp0", "apple,t6034-handoff", 1) &&
+                  u32_is(dt, "disp0-piodma", "apple,t6034-handoff", 1);
+    if (scenario != J514M_PUBLISH) {
+        check(!marked && !fdt_getprop(dt, dcp, "memory-region", NULL),
+              "J514M refusal: no display handoff");
+        check(!count_writes(DART_DCP, DART_DCP + 0x4000),
+              "J514M refusal: no DCP DART writes");
+    } else {
+        check(marked, "J514M: handoff marker on all three nodes");
+        check(dcp >= 0 && disp >= 0 && pio >= 0 &&
+              fdt_getprop(dt, dcp, "memory-region", NULL), "J514M: DCP regions published");
+        check(reg_val(DART_DCP + 0x200) & 1, "J514M: simulated DCP DART locked");
+    }
+    if (scenario == J514M_POWER_FAULT) {
+        check(exc_count == 1, "J514M: first display power read fault was guarded");
+        check(ps_reads == 1, "J514M: no subsequent display power register read");
+    }
+    if (scenario == J514M_MISSING_FE || scenario == J514M_MISSING_CPU)
+        check(ps_reads == 0, "J514M: unexpected power topology refused before PMGR reads");
+    check(!unguarded, "J514M: no unguarded faults");
+}

diff --git a/tests/mcc_carveout_host.c b/tests/mcc_carveout_host.c
new file mode 100644
index 0000000..b657b08
--- /dev/null
+++ b/tests/mcc_carveout_host.c
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: MIT */
+/* Host-only test of the extracted real mcc_unmap_carveouts() function. */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef uint32_t u32;
+typedef uint64_t u64;
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#define REGION_RWX_EL0 0x1000000000000000ULL
+#define REGION_RW_EL0  0x2000000000000000ULL
+#define REGION_RX_EL1  0x3000000000000000ULL
+
+struct mcc_carveout { u64 base, size; };
+struct tz_regs { u32 count, stride, start, end, enable; };
+static bool mcc_initialized;
+static struct { struct tz_regs *tz; } mcc_regs[1];
+static size_t mcc_carveout_count;
+static struct mcc_carveout mcc_carveouts[5];
+static bool mcc_carveouts_valid;
+static u64 ram_base, mem_size_actual;
+static void *adt;
+static u32 fake_regs[12];
+static bool have_fallback_node, have_second_fallback;
+static u64 fallback[2][2];
+static unsigned int unmaps;
+
+static u32 plane_read32(int mcc, int plane, u64 offset)
+{
+    assert(!mcc && !plane && offset / 4 < ARRAY_SIZE(fake_regs));
+    return fake_regs[offset / 4];
+}
+static void mmu_rm_mapping(u64 base, u64 size) { (void)base; (void)size; unmaps++; }
+static size_t get_page_size(void) { return 16384; }
+static int adt_path_offset(const void *tree, const char *path)
+{
+    (void)tree; (void)path;
+    return have_fallback_node ? 1 : -1;
+}
+static const void *adt_getprop(const void *tree, int node, const char *name, u32 *len)
+{
+    (void)tree; (void)node;
+    if (!strcmp(name, "region-id-4")) { *len = sizeof(fallback[0]); return fallback[0]; }
+    if (!strcmp(name, "region-id-2") && have_second_fallback) {
+        *len = sizeof(fallback[1]);
+        return fallback[1];
+    }
+    return NULL;
+}
+
+#include "mcc_unmap_extracted.inc"
+
+int main(void)
+{
+    struct tz_regs tz = { .count = 4, .stride = 12, .start = 0, .end = 4, .enable = 8 };
+    ram_base = 0x10000000000ULL;
+    mem_size_actual = 0x10000000ULL;
+    mcc_regs[0].tz = &tz;
+
+    mcc_carveouts_valid = true;
+    assert(mcc_unmap_carveouts() == -1 && !mcc_carveouts_valid);
+    mcc_initialized = true;
+    assert(mcc_unmap_carveouts() == 0 && mcc_carveouts_valid && !mcc_carveout_count);
+    fake_regs[0] = 1; fake_regs[1] = 2; fake_regs[2] = 1;
+    assert(mcc_unmap_carveouts() == 0 && mcc_carveouts_valid && mcc_carveout_count == 1);
+    fake_regs[3] = 0; fake_regs[4] = 2; fake_regs[5] = 1;
+    assert(mcc_unmap_carveouts() == 0 && !mcc_carveouts_valid && mcc_carveout_count == 1);
+    fake_regs[3] = 0x20000; fake_regs[4] = 0x20001; fake_regs[5] = 1;
+    assert(mcc_unmap_carveouts() == 0 && !mcc_carveouts_valid);
+    mem_size_actual = UINT64_MAX;
+    assert(mcc_unmap_carveouts() == -1 && !mcc_carveouts_valid);
+    mem_size_actual = 0x10000000ULL;
+    mcc_regs[0].tz = NULL;
+    assert(mcc_unmap_carveouts() == -1 && !mcc_carveouts_valid);
+    have_fallback_node = true;
+    fallback[0][0] = ram_base + 0x4000; fallback[0][1] = 0x4000;
+    fallback[1][0] = ram_base + 0x8000; fallback[1][1] = 0x4000;
+    assert(mcc_unmap_carveouts() == -1 && !mcc_carveouts_valid);
+    have_second_fallback = true;
+    assert(mcc_unmap_carveouts() == 0 && !mcc_carveouts_valid && mcc_carveout_count == 2);
+    fallback[1][1] = 1;
+    assert(mcc_unmap_carveouts() == -1 && !mcc_carveouts_valid);
+    puts("MCC inventory host checks passed");
+    return 0;
+}
